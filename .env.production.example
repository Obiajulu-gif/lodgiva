# Lodgiva production environment CONTRACT — placeholders only, never real values.
# IMPORTANT: current code is NOT production-ready for PostgreSQL/R2/Redis.
# Read docs/DEPLOYMENT_ENVIRONMENT_GUIDE.md and docs/audit/EXECUTIVE_SUMMARY.md.

NODE_ENV=production
APP_RELEASE=git-sha-or-release-id
API_PORT=4000

# BLOCKED until the PostgreSQL schema, migrations, pooling, and RLS are implemented.
DATABASE_URL=postgresql://app_user:REPLACE_ME@db.example.invalid:5432/lodgiva?sslmode=require

# Generate 64+ random bytes. Current runtime uses one symmetric key.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Generate exactly 32 random bytes and encode them as base64.
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Exact comma-separated HTTPS dashboard origin(s); never blank or wildcard.
CORS_ORIGINS=https://dashboard.example.invalid

DB_TX_MAX_WAIT_MS=5000
DB_TX_TIMEOUT_MS=15000
DB_TX_RETRIES=3
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
HOLD_MINUTES=15

# Keep sandbox until provider certification and finance sign-off.
PAYMENTS_MODE=sandbox
PAYSTACK_SECRET_KEY=REPLACE_IN_SECRET_STORE
FLUTTERWAVE_SECRET_KEY=REPLACE_IN_SECRET_STORE
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_IN_SECRET_STORE

# Cloudflare R2 (S3-compatible); local disk is refused in production.
STORAGE_ADAPTER=r2
STORAGE_SIGNING_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
STORAGE_BASE_URL=https://api.example.invalid/api/v1/files
R2_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_IN_SECRET_STORE
R2_SECRET_ACCESS_KEY=REPLACE_IN_SECRET_STORE
R2_PUBLIC_BUCKET=lodgiva-public-production
R2_PRIVATE_BUCKET=lodgiva-private-production
R2_PUBLIC_BASE_URL=https://assets.example.invalid
UPLOAD_INTENT_TTL=900
DOWNLOAD_URL_TTL=300

VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_IN_SECRET_STORE
VAPID_SUBJECT=mailto:ops@example.invalid

OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer REPLACE_IN_SECRET_STORE
OTEL_SAMPLE_RATE=0.1
OTEL_SERVICE_NAME=lodgiva-api
SENTRY_DSN=REPLACE_IN_SECRET_STORE
SLO_LATENCY_MS=750

# REQUIRED BY THE TARGET ARCHITECTURE BUT NOT CONSUMED BY CURRENT CODE.
# Setting these does nothing until the corresponding adapters are implemented.
# REDIS_URL=rediss://REPLACE_ME
# RESEND_API_KEY=REPLACE_IN_SECRET_STORE
# TERMII_API_KEY=REPLACE_IN_SECRET_STORE
