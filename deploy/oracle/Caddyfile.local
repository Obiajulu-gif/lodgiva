# The laptop demo: Cloudflare Tunnel -> Caddy on :8001 -> Frappe on :8002
# or the Vercel landing page. The tunnel terminates HTTPS, so Caddy speaks
# plain HTTP here.
{
	admin off
	auto_https off
}

import Caddyfile.routes

:8001 {
	# Frappe's realtime service runs on its own port on the laptop; on Oracle
	# the frappe_docker frontend already routes /socket.io internally.
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:9001
	}
	import lodgiva_routes
}
