# Lodgiva on one address: the landing page at /, the PMS behind it.
#
# The landing page stays on Vercel (apps/marketing-web). Caddy fetches it
# from there for every path the PMS does not own, so the public site is
# never rebuilt or redeployed here. The PMS paths go to Frappe.
#
# Imported by Caddyfile (Oracle) and Caddyfile.local (the laptop tunnel).
# FRAPPE_UPSTREAM is where Frappe answers: the frappe_docker `frontend`
# container on Oracle, `127.0.0.1:8002` on the laptop.

(lodgiva_routes) {
	# The landing page's "Log in" and "Get started" buttons lead to the PMS.
	# Deliberately NOT to the legacy Next.js signup: through this address it
	# would create tenants in the production Neon database.
	redir /signup /login 302
	redir /dashboard /lodgiva 302
	redir /dashboard/* /lodgiva 302

	# Staff-facing provisioning console (lodgiva_control), which lives on its
	# own site so the billing console is never restricted by the billing state
	# it enforces.
	#
	# A redirect, not a proxy. Desk owns /app, /api, /assets and /login at the
	# root, and those paths are already claimed below by the PMS. Proxying only
	# /admin to the control site gets the first HTML page and then sends every
	# asset and API call it triggers to the hotel site instead - wrong site,
	# wrong session. The console needs a whole origin, so it gets one:
	# LODGIVA_CONTROL_URL (port 8011 on the laptop, control.<apex> on a server).
	#
	# The default matters: an unset variable here used to leave `header_up Host`
	# with no argument, which fails config adaptation and stops Caddy booting -
	# taking the landing page and the PMS down with it, not just /admin.
	redir /admin {$LODGIVA_CONTROL_URL:http://localhost:8011}/app/hotels-console 302
	redir /admin/* {$LODGIVA_CONTROL_URL:http://localhost:8011}/app/hotels-console 302

	@pms path /lodgiva /lodgiva/* /kamra /kamra/* \
		/book /book/* /stay /stay/* /hk /hk/* /checkin/* \
		/app /app/* /apps /login /logout /update-password* /me /message \
		/api/method/* /api/resource/* /api/v2/* \
		/assets/* /files/* /private/* /socket.io/* \
		/website_script.js /print/* /printview* /desk*

	handle @pms {
		reverse_proxy {$FRAPPE_UPSTREAM} {
			# Name the site explicitly. Frappe reads this header before it looks
			# at Host, and unlike a Host rewrite it leaves Origin matching Host,
			# which the realtime server insists on.
			#
			# Unset, it sends the header empty, and an empty value is falsy in
			# Frappe - so the site falls back to Host, which is what the server
			# wants: there, one hostname per hotel IS the routing. Only the
			# laptop sets it, because every site is reached through localhost
			# and the hostname carries no site name.
			#
			# Do not write the default as a placeholder: `{$VAR:{http.request.host}}`
			# adapts to the literal `kamra.localhost}`, trailing brace and all.
			header_up X-Frappe-Site-Name "{$LODGIVA_PMS_SITE:}"
		}
	}

	# Everything else - /, /_next/*, pricing, features - is the landing page.
	handle {
		reverse_proxy https://lodgiva.vercel.app {
			header_up Host lodgiva.vercel.app
		}
	}
}
