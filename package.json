{
  "name": "lodgiva-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @lodgiva/database migrate",
    "db:seed": "pnpm --filter @lodgiva/database seed",
    "db:bootstrap": "pnpm --filter @lodgiva/database bootstrap",
    "api": "pnpm --filter @lodgiva/api dev",
    "worker": "pnpm --filter @lodgiva/worker dev",
    "dashboard": "pnpm --filter @lodgiva/dashboard-web dev",
    "marketing": "pnpm --filter lodgiva dev",
    "openapi": "node apps/api/scripts/emit-openapi.mjs",
    "generate:client": "node packages/database/src/generate-client.mjs",
    "test:unit": "pnpm --filter @lodgiva/api test:unit",
    "test:integration": "pnpm --filter @lodgiva/api test:integration",
    "test:e2e": "pnpm --filter @lodgiva/api test:e2e",
    "backup": "node scripts/backup.mjs --verify",
    "restore:drill": "node scripts/restore.mjs --drill",
    "check:migrations": "node scripts/check-migrations.mjs --strict",
    "load-test": "node scripts/load-test.mjs",
    "seed:demo": "node packages/database/src/seed-demo.js --reset"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-fastify>fastify": "5.12.1",
      "fast-json-stringify>fast-uri": "4.1.4",
      "@fastify/ajv-compiler>fast-uri": "3.1.6",
      "ajv>fast-uri": "3.1.7",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "@nestjs/swagger>js-yaml": "5.2.2",
      "next>postcss": "8.5.27",
      "postcss>nanoid": "3.3.18",
      "minimatch>brace-expansion": "5.0.9"
    }
  }
}
