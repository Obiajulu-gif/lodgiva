{
  "name": "@lodgiva/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "test": "node test/run-e2e.mjs",
    "test:against-running-db": "node test/e2e.mjs",
    "test:unit": "node --test test/unit/permissions.test.mjs test/unit/csv.test.mjs test/unit/restrictions.test.mjs test/unit/reservation-state.test.mjs test/unit/confirmation-code.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/identity.test.mjs test/integration/property-config.test.mjs test/integration/booking.test.mjs test/integration/reservation-lifecycle.test.mjs",
    "test:e2e": "node test/run-e2e.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@lodgiva/database": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.10.0",
    "argon2": "^0.41.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}