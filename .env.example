# ── Lodgiva environment variables ─────────────────────────────
# The demo site needs NONE of these. They are for the full platform build-out.
# Copy to .env.local and fill in. Never commit real values.

# Payments — get from https://dashboard.paystack.com (Settings → API Keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Payments — get from https://dashboard.flutterwave.com (Settings → API Keys)
FLUTTERWAVE_SECRET_KEY=

# SMS / WhatsApp — get from https://termii.com (API Settings)
TERMII_API_KEY=

# Email — get from https://resend.com (API Keys)
RESEND_API_KEY=

# Database — any managed PostgreSQL (Neon / Supabase / Railway)
DATABASE_URL=

# Cloudflare R2 object storage — Cloudflare dashboard → R2 → API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=

# ── Payments ─────────────────────────────────────────────────────────────
# Outbound money operations fail closed: adapters stay in SANDBOX unless this
# is explicitly "live". A test-looking key alone is NOT enough.
PAYMENTS_MODE=sandbox

# Paystack (dashboard.paystack.com → Settings → API Keys)
PAYSTACK_SECRET_KEY=
# Flutterwave (dashboard.flutterwave.com → Settings → API Keys)
FLUTTERWAVE_SECRET_KEY=
# Flutterwave webhook secret hash (Settings → Webhooks). Echoed in verif-hash.
FLUTTERWAVE_WEBHOOK_HASH=

# ── File storage (§11) ───────────────────────────────────────────────────
# No object store configured => local filesystem adapter with real presigning.
# For R2/MinIO set endpoint + credentials and the S3 adapter takes over.
STORAGE_LOCAL_ROOT=
STORAGE_SIGNING_KEY=change-me-in-production
STORAGE_BASE_URL=http://localhost:4000/api/v1/files
UPLOAD_INTENT_TTL=900
DOWNLOAD_URL_TTL=300
