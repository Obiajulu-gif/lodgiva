# ── Lodgiva environment variables ─────────────────────────────
# The demo site needs NONE of these. They are for the full platform build-out.
# Copy to .env.local and fill in. Never commit real values.

# Payments — get from https://dashboard.paystack.com (Settings → API Keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Payments — get from https://dashboard.flutterwave.com (Settings → API Keys)
FLUTTERWAVE_SECRET_KEY=

# SMS / WhatsApp — get from https://termii.com (API Settings)
TERMII_API_KEY=

# Email — get from https://resend.com (API Keys)
RESEND_API_KEY=

# Database — any managed PostgreSQL (Neon / Supabase / Railway)
DATABASE_URL=

# Cloudflare R2 object storage — Cloudflare dashboard → R2 → API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
