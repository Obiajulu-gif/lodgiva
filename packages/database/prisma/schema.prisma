// Lodgiva core schema — spec §8.2 entity catalogue (working subset).
//
// ADR-LOCAL-001: SQLite is used for local development because Docker/PostgreSQL
// is unavailable on this machine. The schema avoids SQLite-only features so that
// switching to PostgreSQL is a provider + DATABASE_URL change. Money is stored
// as BigInt minor units (kobo) per §7.3 — never floats. Status fields are
// strings validated at the application layer (SQLite has no enums); the API is
// the single writer and enforces the state machines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid())
  legalName       String
  displayName     String
  slug            String   @unique
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | TRIAL
  defaultCurrency String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties  Property[]
  memberships Membership[]
  invitations Invitation[]
}

model Property {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  code         String
  slug         String
  timezone     String   @default("Africa/Lagos")
  businessDate String // ISO date, advanced ONLY by night audit (§7.4 / ADR-009)
  checkinTime  String   @default("14:00")
  checkoutTime String   @default("12:00")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  roomTypes          RoomType[]
  rooms              Room[]
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  nightAuditRuns     NightAuditRun[]
  outlets            Outlet[]
  cashierShifts      CashierShift[]
  maintenanceTickets MaintenanceTicket[]
  taxRules           TaxRule[]
  ratePlans          RatePlan[]
  approvalRequests   ApprovalRequest[]
  amenities          Amenity[]
  roomBlocks         RoomBlock[]
  memberScopes       MembershipProperty[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  fullName     String
  status       String    @default("ACTIVE")
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  // §6.3 — progressive delay rather than permanent lock, so a staff member
  // is never locked out of the front desk during a rush.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  invitesSent Invitation[] @relation("InvitedBy")
}

model Membership {
  id            String  @id @default(uuid())
  tenantId      String
  userId        String
  role          String // TENANT_OWNER | GENERAL_MANAGER | FRONT_DESK | CASHIER | HOUSEKEEPING | MAINTENANCE | FINANCE | AUDITOR
  status        String  @default("ACTIVE")
  // When false, access is limited to the properties listed in `properties`.
  allProperties Boolean @default(true)
  createdAt     DateTime @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])
  properties MembershipProperty[]

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

/** §6.4 resource scope: which properties a scoped membership may access. */
model MembershipProperty {
  id           String @id @default(uuid())
  tenantId     String
  membershipId String
  propertyId   String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id])

  @@unique([membershipId, propertyId])
  @@index([tenantId, propertyId])
}

/** Staff onboarding: an invitation is accepted to create the user + membership. */
model Invitation {
  id            String    @id @default(uuid())
  tenantId      String
  email         String
  fullName      String
  role          String
  tokenHash     String    @unique
  allProperties Boolean   @default(true)
  propertyIds   String    @default("[]") // JSON array when scoped
  status        String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt     DateTime
  acceptedAt    DateTime?
  invitedById   String
  createdAt     DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId, status])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  ipHash           String?
  userAgent        String?
  lastActivityAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model RoomType {
  id            String @id @default(uuid())
  tenantId      String
  propertyId    String
  code          String
  name          String
  baseOccupancy Int    @default(2)
  maxOccupancy  Int    @default(2)
  baseRateMinor BigInt // kobo per night

  description   String?
  status        String @default("ACTIVE")

  property  Property          @relation(fields: [propertyId], references: [id])
  rooms     Room[]
  ratePlans RatePlan[]
  amenities RoomTypeAmenity[]

  @@unique([tenantId, propertyId, code])
}

model Room {
  id                String @id @default(uuid())
  tenantId          String
  propertyId        String
  roomTypeId        String
  roomNumber        String
  floor             Int      @default(1)
  operationalStatus String   @default("VACANT_CLEAN") // §7.2 room operational states
  // Defaulted so the column can be added to existing rows without a reset.
  updatedAt         DateTime @default(now()) @updatedAt // drives the sync change feed

  property Property @relation(fields: [propertyId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  amenities          RoomAmenity[]
  blocks             RoomBlock[]

  @@unique([tenantId, propertyId, roomNumber])
  @@index([tenantId, propertyId, operationalStatus])
}

model Guest {
  id          String   @id @default(uuid())
  tenantId    String
  firstName   String
  lastName    String
  phone       String?
  email       String?
  nationality String?
  notes       String?
  vip         Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  folios       Folio[]

  @@index([tenantId, lastName])
  @@index([tenantId, phone])
}

model Reservation {
  id               String   @id @default(uuid())
  tenantId         String
  propertyId       String
  confirmationCode String
  primaryGuestId   String
  source           String   @default("DIRECT")
  // §7.1 state machine: DRAFT HOLD PENDING_PAYMENT CONFIRMED CHECKED_IN CHECKED_OUT CANCELLED NO_SHOW
  status           String   @default("CONFIRMED")
  arrivalDate      String // ISO date
  departureDate    String
  adults           Int      @default(1)
  children         Int      @default(0)
  currency         String   @default("NGN")
  notes            String?
  version          Int      @default(1) // optimistic concurrency (§9.1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  guest    Guest    @relation(fields: [primaryGuestId], references: [id])

  rooms  ReservationRoom[]
  folios Folio[]

  @@unique([tenantId, propertyId, confirmationCode])
  @@index([tenantId, propertyId, arrivalDate, status])
  @@index([tenantId, propertyId, departureDate, status])
}

model ReservationRoom {
  id               String  @id @default(uuid())
  tenantId         String
  reservationId    String
  roomTypeId       String
  roomId           String?
  arrivalDate      String
  departureDate    String
  adults           Int     @default(1)
  children         Int     @default(0)
  nightlyRateMinor BigInt
  status           String  @default("RESERVED") // RESERVED | IN_HOUSE | DEPARTED | RELEASED

  reservation Reservation @relation(fields: [reservationId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])

  @@index([tenantId, roomId, status])
}

model Folio {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  reservationId String?
  guestId       String
  status        String    @default("OPEN") // OPEN | CLOSED
  currency      String    @default("NGN")
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])

  entries  FolioEntry[]
  payments Payment[]

  @@index([tenantId, propertyId, status])
}

// §7.3: append-only ledger. Rows are NEVER updated or deleted by the
// application; corrections post a REVERSAL row referencing the original.
model FolioEntry {
  id           String   @id @default(uuid())
  tenantId     String
  folioId      String
  type         String // ROOM_CHARGE | POS_CHARGE | TAX | SERVICE_CHARGE | DISCOUNT | PAYMENT | REFUND | REVERSAL
  description  String
  amountMinor  BigInt // signed: charges positive, payments/credits negative
  taxCode      String?
  // §13.3: the tax rule version applied at posting time, kept so historical
  // invoices never change when tax configuration is updated.
  taxRuleId      String?
  taxRuleVersion Int?
  reversalOfId String?  @unique
  businessDate String
  postedById   String?
  postedAt     DateTime @default(now())

  folio      Folio       @relation(fields: [folioId], references: [id])
  reversalOf FolioEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy FolioEntry? @relation("Reversal")

  @@index([tenantId, folioId, postedAt])
}

model Payment {
  id                String   @id @default(uuid())
  tenantId          String
  propertyId        String
  folioId           String
  method            String // CASH | BANK_TRANSFER | CARD | POS_TERMINAL | PAYMENT_LINK
  provider          String? // Paystack | Flutterwave | Manual | FrontDesk
  amountMinor       BigInt
  status            String   @default("CONFIRMED") // PENDING | CONFIRMED | FAILED | REFUNDED
  externalReference String?
  idempotencyKey    String?
  receivedAt        DateTime @default(now())
  recordedById      String?

  folio Folio @relation(fields: [folioId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, propertyId, status])
}

model HousekeepingTask {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String
  businessDate String
  type         String    @default("FULL_CLEAN") // FULL_CLEAN | TURNOVER | INSPECTION | DEEP_CLEAN | MAINTENANCE
  priority     String    @default("NORMAL")
  assignedTo   String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | INSPECTED
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  version      Int       @default(1) // optimistic concurrency for offline sync
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, businessDate, status])
}

/** Amenities are shared vocabulary, attachable to a room type or a room. */
model Amenity {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  code       String
  name       String
  category   String @default("ROOM") // ROOM | BATHROOM | TECH | ACCESSIBILITY | PROPERTY
  icon       String?

  property  Property        @relation(fields: [propertyId], references: [id])
  roomTypes RoomTypeAmenity[]
  rooms     RoomAmenity[]

  @@unique([tenantId, propertyId, code])
}

model RoomTypeAmenity {
  id         String @id @default(uuid())
  tenantId   String
  roomTypeId String
  amenityId  String

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
}

model RoomAmenity {
  id        String @id @default(uuid())
  tenantId  String
  roomId    String
  amenityId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomId, amenityId])
}

/**
 * A dated removal of a room from sellable inventory (§7.2). Distinct from the
 * momentary operational status: a block has a range, a reason and an owner,
 * and availability must subtract it.
 */
model RoomBlock {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String
  type         String    @default("OUT_OF_ORDER") // OUT_OF_ORDER | OUT_OF_SERVICE | HOUSE_USE
  reason       String
  startDate    String // ISO date, inclusive
  endDate      String // ISO date, exclusive
  status       String    @default("ACTIVE") // ACTIVE | RELEASED
  createdById  String
  releasedById String?
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status, startDate])
}

// §13.3 — tax rules are versioned by effective date. Posted folio lines store
// the rule version they were billed under, so changing configuration never
// rewrites history.
model TaxRule {
  id                 String  @id @default(uuid())
  tenantId           String
  propertyId         String
  code               String // VAT | LSCT | SVC
  name               String
  rateBp             Int // basis points (750 = 7.5%)
  appliesTo          String  @default("ALL") // ALL | ROOM | FB
  basis              String  @default("EXCLUSIVE") // EXCLUSIVE | INCLUSIVE
  compoundOrder      Int     @default(1) // lower runs first; VAT usually after service
  taxOnServiceCharge Boolean @default(true)
  version            Int     @default(1)
  effectiveFrom      String // ISO date
  effectiveTo        String? // null = open-ended
  createdById        String?

  property Property @relation(fields: [propertyId], references: [id])

  @@unique([tenantId, propertyId, code, version])
  @@index([tenantId, propertyId, effectiveFrom])
}

model RatePlan {
  id           String  @id @default(uuid())
  tenantId     String
  propertyId   String
  roomTypeId   String
  code         String
  name         String
  refundable   Boolean @default(true)
  minStay      Int     @default(1)
  includesBreakfast Boolean @default(false)
  status       String  @default("ACTIVE")

  property    Property     @relation(fields: [propertyId], references: [id])
  roomType    RoomType     @relation(fields: [roomTypeId], references: [id])
  dailyRates  DailyRate[]

  @@unique([tenantId, propertyId, code])
}

// Per-date pricing overrides; falls back to the room type base rate.
model DailyRate {
  id         String @id @default(uuid())
  tenantId   String
  ratePlanId String
  date       String // ISO date
  rateMinor  BigInt
  closed     Boolean @default(false) // restriction: closed to arrival/stay

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([ratePlanId, date])
}

// §13.4 — threshold-driven approvals with an explicit second actor.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  type          String // DISCOUNT | REFUND | FOLIO_REOPEN | CASH_VARIANCE | RATE_OVERRIDE
  entityType    String
  entityId      String
  amountMinor   BigInt?
  reason        String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  payload       String    @default("{}") // JSON: what to apply on approval
  requestedById String
  decidedById   String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId, propertyId, status])
}

// §10.4 — operationId is the idempotency key for offline mutations.
model SyncOperation {
  id          String   @id @default(uuid())
  tenantId    String
  operationId String
  deviceId    String
  userId      String
  entityType  String
  entityId    String
  action      String
  status      String // APPLIED | CONFLICT | REJECTED
  detail      String   @default("{}")
  createdAt   DateTime @default(now())

  @@unique([tenantId, operationId])
  @@index([tenantId, deviceId, createdAt])
}

model Outlet {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  code       String
  name       String
  type       String @default("RESTAURANT") // RESTAURANT | BAR | ROOM_SERVICE | SPA | LAUNDRY
  status     String @default("ACTIVE")

  property  Property   @relation(fields: [propertyId], references: [id])
  menuItems MenuItem[]
  orders    PosOrder[]

  @@unique([tenantId, propertyId, code])
}

model MenuItem {
  id         String  @id @default(uuid())
  tenantId   String
  outletId   String
  code       String
  name       String
  category   String  @default("MAINS")
  priceMinor BigInt
  taxable    Boolean @default(true)
  active     Boolean @default(true)

  outlet Outlet         @relation(fields: [outletId], references: [id])
  lines  PosOrderLine[]

  @@unique([tenantId, outletId, code])
}

model PosOrder {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  outletId      String
  orderNumber   String
  status        String    @default("OPEN") // OPEN | SETTLED | VOIDED
  settlement    String? // ROOM_POSTING | CASH | CARD | POS_TERMINAL | TRANSFER
  folioId       String? // set when posted to a guest room folio
  tableRef      String?
  subtotalMinor BigInt    @default(0)
  serviceMinor  BigInt    @default(0)
  taxMinor      BigInt    @default(0)
  totalMinor    BigInt    @default(0)
  businessDate  String
  shiftId       String?
  voidReason    String?
  openedById    String?
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  outlet Outlet         @relation(fields: [outletId], references: [id])
  shift  CashierShift?  @relation(fields: [shiftId], references: [id])
  lines  PosOrderLine[]

  @@unique([tenantId, propertyId, orderNumber])
  @@index([tenantId, propertyId, businessDate, status])
}

model PosOrderLine {
  id          String @id @default(uuid())
  tenantId    String
  orderId     String
  menuItemId  String
  description String
  quantity    Int    @default(1)
  unitMinor   BigInt
  lineMinor   BigInt

  order    PosOrder @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// §7.4 / MVP: cashier shift open → movements → close with variance.
model CashierShift {
  id                String    @id @default(uuid())
  tenantId          String
  propertyId        String
  shiftNumber       String
  userId            String
  status            String    @default("OPEN") // OPEN | CLOSED | PENDING_APPROVAL
  openingFloatMinor BigInt    @default(0)
  countedMinor      BigInt?
  expectedMinor     BigInt?
  varianceMinor     BigInt?
  varianceReason    String?
  approvedById      String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  property  Property       @relation(fields: [propertyId], references: [id])
  movements CashMovement[]
  posOrders PosOrder[]

  @@unique([tenantId, propertyId, shiftNumber])
  @@index([tenantId, propertyId, status])
}

model CashMovement {
  id          String   @id @default(uuid())
  tenantId    String
  shiftId     String
  type        String // PAYMENT_IN | REFUND_OUT | DROP_TO_SAFE | PETTY_CASH_OUT | FLOAT_IN
  amountMinor BigInt // signed relative to the drawer
  reference   String?
  note        String?
  recordedById String?
  createdAt   DateTime @default(now())

  shift CashierShift @relation(fields: [shiftId], references: [id])

  @@index([tenantId, shiftId])
}

model MaintenanceTicket {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String?
  title        String
  description  String?
  priority     String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  blocksRoom   Boolean   @default(false)
  assignedTo   String?
  reportedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
}

// §12.3: append-only. No update/delete path exists in the application.
model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  propertyId String?
  actorType  String   @default("USER") // USER | API_CLIENT | SYSTEM | SUPPORT
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String // redacted JSON text
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, propertyId, createdAt(sort: Desc)])
}

// §9.3: written in the same transaction as the state change.
model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String // JSON text
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, occurredAt])
}

model NightAuditRun {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  businessDate String
  status       String    @default("COMPLETED")
  summary      String // JSON text of KPI snapshot
  completedAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  // §7.4: idempotent by property + business date
  @@unique([propertyId, businessDate])
}
