// Lodgiva core schema — spec §8.2 entity catalogue (working subset).
//
// ADR-LOCAL-001: SQLite is used for local development because Docker/PostgreSQL
// is unavailable on this machine. The schema avoids SQLite-only features so that
// switching to PostgreSQL is a provider + DATABASE_URL change. Money is stored
// as BigInt minor units (kobo) per §7.3 — never floats. Status fields are
// strings validated at the application layer (SQLite has no enums); the API is
// the single writer and enforces the state machines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String   @id @default(uuid())
  legalName       String
  displayName     String
  slug            String   @unique
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | TRIAL
  defaultCurrency String   @default("NGN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties  Property[]
  memberships Membership[]
  invitations Invitation[]
}

model Property {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  code         String
  slug         String
  timezone     String   @default("Africa/Lagos")
  businessDate String // ISO date, advanced ONLY by night audit (§7.4 / ADR-009)
  checkinTime  String   @default("14:00")
  checkoutTime String   @default("12:00")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  roomTypes          RoomType[]
  rooms              Room[]
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  nightAuditRuns     NightAuditRun[]
  outlets            Outlet[]
  cashierShifts      CashierShift[]
  maintenanceTickets MaintenanceTicket[]
  taxRules           TaxRule[]
  ratePlans          RatePlan[]
  approvalRequests   ApprovalRequest[]
  amenities          Amenity[]
  roomBlocks         RoomBlock[]
  holds              Hold[]
  memberScopes       MembershipProperty[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  fullName     String
  status       String    @default("ACTIVE")
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  // §6.3 — progressive delay rather than permanent lock, so a staff member
  // is never locked out of the front desk during a rush.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  invitesSent Invitation[] @relation("InvitedBy")
}

model Membership {
  id            String  @id @default(uuid())
  tenantId      String
  userId        String
  role          String // TENANT_OWNER | GENERAL_MANAGER | FRONT_DESK | CASHIER | HOUSEKEEPING | MAINTENANCE | FINANCE | AUDITOR
  status        String  @default("ACTIVE")
  // When false, access is limited to the properties listed in `properties`.
  allProperties Boolean @default(true)
  createdAt     DateTime @default(now())

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])
  properties MembershipProperty[]

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

/** §6.4 resource scope: which properties a scoped membership may access. */
model MembershipProperty {
  id           String @id @default(uuid())
  tenantId     String
  membershipId String
  propertyId   String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id])

  @@unique([membershipId, propertyId])
  @@index([tenantId, propertyId])
}

/** Staff onboarding: an invitation is accepted to create the user + membership. */
model Invitation {
  id            String    @id @default(uuid())
  tenantId      String
  email         String
  fullName      String
  role          String
  tokenHash     String    @unique
  allProperties Boolean   @default(true)
  propertyIds   String    @default("[]") // JSON array when scoped
  status        String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  expiresAt     DateTime
  acceptedAt    DateTime?
  invitedById   String
  createdAt     DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId, status])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  ipHash           String?
  userAgent        String?
  lastActivityAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
}

model RoomType {
  id            String @id @default(uuid())
  tenantId      String
  propertyId    String
  code          String
  name          String
  baseOccupancy Int    @default(2)
  maxOccupancy  Int    @default(2)
  baseRateMinor BigInt // kobo per night

  description   String?
  status        String @default("ACTIVE")

  property    Property              @relation(fields: [propertyId], references: [id])
  rooms       Room[]
  ratePlans   RatePlan[]
  amenities   RoomTypeAmenity[]
  holds       Hold[]
  allocations RoomNightAllocation[]

  @@unique([tenantId, propertyId, code])
}

model Room {
  id                String @id @default(uuid())
  tenantId          String
  propertyId        String
  roomTypeId        String
  roomNumber        String
  floor             Int      @default(1)
  operationalStatus String   @default("VACANT_CLEAN") // §7.2 room operational states
  // Defaulted so the column can be added to existing rows without a reset.
  updatedAt         DateTime @default(now()) @updatedAt // drives the sync change feed

  property Property @relation(fields: [propertyId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  amenities          RoomAmenity[]
  blocks             RoomBlock[]

  @@unique([tenantId, propertyId, roomNumber])
  @@index([tenantId, propertyId, operationalStatus])
}

model Guest {
  id          String   @id @default(uuid())
  tenantId    String
  firstName   String
  lastName    String
  phone       String?
  email       String?
  nationality String?
  notes       String?
  vip         Boolean  @default(false)
  // §7 Guests and CRM
  idDocumentType   String? // PASSPORT | NIN | DRIVERS_LICENCE | VOTERS_CARD
  idDocumentLast4  String? // only the last 4 are retained (§12.2 minimisation)
  idDocumentExpiry String?
  marketingConsent Boolean @default(false)
  consentUpdatedAt DateTime?
  blacklisted      Boolean @default(false)
  blacklistReason  String?
  // Set when this profile has been merged into another; the row is kept so
  // historic reservations and folios never lose their subject.
  mergedIntoId String?
  mergedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  folios       Folio[]
  mergedInto   Guest?  @relation("GuestMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Guest[] @relation("GuestMerge")

  @@index([tenantId, lastName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, mergedIntoId])
}

/** Audit of guest profile merges so a merge can be explained and reviewed. */
model GuestMergeLog {
  id           String   @id @default(uuid())
  tenantId     String
  survivingId  String
  mergedId     String
  movedCounts  String // JSON: { reservations, folios }
  performedById String
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}

/**
 * §7 Rates and Availability — per-date selling restrictions.
 *
 * Separate from DailyRate because a restriction can apply without a price
 * override (and a price can change without touching restrictions).
 */
model RateRestriction {
  id           String  @id @default(uuid())
  tenantId     String
  ratePlanId   String
  date         String // ISO date
  closed       Boolean @default(false) // closed to sale entirely
  closedToArrival   Boolean @default(false) // CTA
  closedToDeparture Boolean @default(false) // CTD
  minStay      Int? // overrides the plan default for stays arriving this date
  maxStay      Int?
  minAdvanceDays Int?

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@index([tenantId, date])
}

/**
 * A short-lived reservation of inventory created by the booking funnel.
 *
 * Holds consume real inventory (they own RoomNightAllocation rows), so a quote
 * that has been held cannot be oversold while the guest is paying. Expiry is
 * enforced on read as well as by the worker, so a crashed sweeper can never
 * leave inventory stuck.
 */
model Hold {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  roomTypeId    String
  ratePlanId    String?
  tokenHash     String    @unique
  arrivalDate   String
  departureDate String
  adults        Int       @default(1)
  children      Int       @default(0)
  quotedTotalMinor BigInt
  quotedBreakdown  String  @default("[]") // JSON night-by-night, frozen at quote time
  currency      String    @default("NGN")
  status        String    @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED | EXPIRED
  expiresAt     DateTime
  consumedAt    DateTime?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())

  property    Property                @relation(fields: [propertyId], references: [id])
  roomType    RoomType                @relation(fields: [roomTypeId], references: [id])
  allocations RoomNightAllocation[]

  @@index([tenantId, status, expiresAt])
}

/**
 * CONCURRENCY-SAFE INVENTORY.
 *
 * One row per sold room-night, holding an explicit slot index in
 * [0, capacity). The unique constraint on (roomTypeId, date, slotIndex) is
 * what makes overbooking impossible: two concurrent bookings racing for the
 * last room both try to insert the same slot, and the database rejects one of
 * them. This is a database invariant rather than an application check, so it
 * holds under any interleaving and does not depend on transaction isolation
 * level — it behaves identically on SQLite and PostgreSQL.
 */
model RoomNightAllocation {
  id                String @id @default(uuid())
  tenantId          String
  propertyId        String
  roomTypeId        String
  date              String // ISO date of the night
  slotIndex         Int
  holdId            String?
  reservationRoomId String?
  createdAt         DateTime @default(now())

  roomType        RoomType         @relation(fields: [roomTypeId], references: [id])
  hold            Hold?            @relation(fields: [holdId], references: [id], onDelete: Cascade)
  reservationRoom ReservationRoom? @relation(fields: [reservationRoomId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date, slotIndex])
  @@index([tenantId, roomTypeId, date])
  @@index([reservationRoomId])
}

model Reservation {
  id               String   @id @default(uuid())
  tenantId         String
  propertyId       String
  confirmationCode String
  primaryGuestId   String
  source           String   @default("DIRECT")
  // §7.1 state machine: DRAFT HOLD PENDING_PAYMENT CONFIRMED CHECKED_IN CHECKED_OUT CANCELLED NO_SHOW
  status           String   @default("CONFIRMED")
  arrivalDate      String // ISO date
  departureDate    String
  adults           Int      @default(1)
  children         Int      @default(0)
  currency         String   @default("NGN")
  notes            String?
  version          Int      @default(1) // optimistic concurrency (§9.1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  guest    Guest    @relation(fields: [primaryGuestId], references: [id])

  rooms  ReservationRoom[]
  folios Folio[]

  @@unique([tenantId, propertyId, confirmationCode])
  @@index([tenantId, propertyId, arrivalDate, status])
  @@index([tenantId, propertyId, departureDate, status])
}

model ReservationRoom {
  id               String  @id @default(uuid())
  tenantId         String
  reservationId    String
  roomTypeId       String
  roomId           String?
  arrivalDate      String
  departureDate    String
  adults           Int     @default(1)
  children         Int     @default(0)
  nightlyRateMinor BigInt
  status           String  @default("RESERVED") // RESERVED | IN_HOUSE | DEPARTED | RELEASED

  reservation Reservation           @relation(fields: [reservationId], references: [id])
  room        Room?                 @relation(fields: [roomId], references: [id])
  allocations RoomNightAllocation[]

  @@index([tenantId, roomId, status])
}

model Folio {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  reservationId String?
  guestId       String
  // Split folios: a stay may carry several (room to the company, extras to
  // the guest). Exactly one is the primary.
  label         String    @default("Main")
  isPrimary     Boolean   @default(true)
  status        String    @default("OPEN") // OPEN | CLOSED
  currency      String    @default("NGN")
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])

  entries  FolioEntry[]
  payments Payment[]
  invoices Invoice[]
  intents  PaymentIntent[]

  @@index([tenantId, propertyId, status])
}

// §7.3: append-only ledger. Rows are NEVER updated or deleted by the
// application; corrections post a REVERSAL row referencing the original.
model FolioEntry {
  id           String   @id @default(uuid())
  tenantId     String
  folioId      String
  type         String // ROOM_CHARGE | POS_CHARGE | TAX | SERVICE_CHARGE | DISCOUNT | PAYMENT | REFUND | REVERSAL
  description  String
  amountMinor  BigInt // signed: charges positive, payments/credits negative
  taxCode      String?
  // §13.3: the tax rule version applied at posting time, kept so historical
  // invoices never change when tax configuration is updated.
  taxRuleId      String?
  taxRuleVersion Int?
  // Both halves of a transfer share this id, so a move between folios can be
  // proven zero-sum and reconstructed later.
  transferGroupId String?
  reversalOfId String?  @unique
  businessDate String
  postedById   String?
  postedAt     DateTime @default(now())

  folio      Folio       @relation(fields: [folioId], references: [id])
  reversalOf FolioEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy FolioEntry? @relation("Reversal")

  @@index([tenantId, folioId, postedAt])
}

model Payment {
  id                String   @id @default(uuid())
  tenantId          String
  propertyId        String
  folioId           String
  method            String // CASH | BANK_TRANSFER | CARD | POS_TERMINAL | PAYMENT_LINK
  provider          String? // Paystack | Flutterwave | Manual | FrontDesk
  amountMinor       BigInt
  status            String   @default("CONFIRMED") // PENDING | CONFIRMED | FAILED | REFUNDED
  externalReference String?
  idempotencyKey    String?
  receivedAt        DateTime @default(now())
  recordedById      String?
  intentId          String?
  // Settled through a provider payout; set by settlement import.
  settlementLineId  String?  @unique
  feeMinor          BigInt   @default(0)
  refundedMinor     BigInt   @default(0)

  folio          Folio           @relation(fields: [folioId], references: [id])
  intent         PaymentIntent?  @relation(fields: [intentId], references: [id])
  settlementLine SettlementLine? @relation(fields: [settlementLineId], references: [id])
  refunds        Refund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, externalReference])
}

/**
 * §13.1 — a payment the guest has been asked for but which the provider has
 * not yet confirmed.
 *
 * The intent is created before the guest is sent to the gateway, so an
 * inbound webhook always has a local record to attach to. Nothing touches
 * the folio until the provider confirms server-side: a redirect back from a
 * gateway is a UI event, not evidence of payment.
 */
model PaymentIntent {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  folioId       String
  provider      String // PAYSTACK | FLUTTERWAVE
  reference     String // our reference, sent to the provider
  providerRef   String? // the provider's own id, learned on confirmation
  amountMinor   BigInt
  currency      String    @default("NGN")
  status        String    @default("PENDING") // PENDING | CONFIRMED | FAILED | ABANDONED
  checkoutUrl   String?
  failureReason String?
  createdById   String?
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?

  folio    Folio     @relation(fields: [folioId], references: [id])
  payments Payment[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
}

/**
 * Every webhook delivery, stored before it is acted upon.
 *
 * The raw body is kept verbatim because the signature is computed over the
 * exact bytes — re-serialising parsed JSON changes whitespace and key order
 * and silently breaks verification. Storing deliveries also makes replay
 * attacks visible and gives an audit trail when a provider disputes what it
 * sent.
 */
model WebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  // Provider's event id where available; falls back to a hash of the body.
  externalId    String
  eventType     String?
  rawBody       String
  signature     String?
  signatureValid Boolean  @default(false)
  status        String    @default("RECEIVED") // RECEIVED | PROCESSED | REJECTED | IGNORED
  rejectReason  String?
  tenantId      String?
  intentId      String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@unique([provider, externalId])
  @@index([provider, status, receivedAt])
}

/** §13.4 — refunds are approval-gated and never silently reduce a payment. */
model Refund {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  paymentId     String
  folioId       String
  amountMinor   BigInt
  reason        String
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | FAILED
  method        String // Mirrors the original payment method.
  providerRef   String?
  requestedById String
  approvedById  String?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([tenantId, propertyId, status])
}

/**
 * A provider payout: the money that actually reached the bank account, which
 * is rarely the sum of the day's payments (fees, timing, reversals).
 */
model Settlement {
  id             String   @id @default(uuid())
  tenantId       String
  propertyId     String
  provider       String
  reference      String
  settledOn      String // ISO date the payout landed
  grossMinor     BigInt
  feeMinor       BigInt   @default(0)
  netMinor       BigInt
  status         String   @default("IMPORTED") // IMPORTED | RECONCILED
  importedById   String?
  createdAt      DateTime @default(now())

  lines      SettlementLine[]
  exceptions ReconciliationException[]

  @@unique([tenantId, provider, reference])
  @@index([tenantId, propertyId, settledOn])
}

model SettlementLine {
  id            String  @id @default(uuid())
  tenantId      String
  settlementId  String
  providerRef   String // the provider's transaction reference
  amountMinor   BigInt
  feeMinor      BigInt  @default(0)
  netMinor      BigInt
  paidOn        String?
  status        String  @default("UNMATCHED") // UNMATCHED | MATCHED | EXCEPTION

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  payment    Payment?

  @@unique([settlementId, providerRef])
  @@index([tenantId, status])
}

/**
 * §13.2 — anything that did not reconcile cleanly. These are worked by
 * finance rather than auto-resolved, because every one of them is either
 * money the hotel has not received or money it cannot account for.
 */
model ReconciliationException {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  settlementId  String?
  kind          String // MISSING_IN_SETTLEMENT | UNKNOWN_IN_SETTLEMENT | AMOUNT_MISMATCH | DUPLICATE_REFERENCE
  severity      String    @default("WARNING") // WARNING | CRITICAL
  providerRef   String?
  paymentId     String?
  expectedMinor BigInt?
  actualMinor   BigInt?
  detail        String
  status        String    @default("OPEN") // OPEN | RESOLVED | WRITTEN_OFF
  resolvedById  String?
  resolutionNote String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([tenantId, propertyId, status])
}

model HousekeepingTask {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String
  businessDate String
  type         String    @default("FULL_CLEAN") // FULL_CLEAN | TURNOVER | INSPECTION | DEEP_CLEAN | MAINTENANCE
  priority     String    @default("NORMAL")
  assignedTo   String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | INSPECTED
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  version      Int       @default(1) // optimistic concurrency for offline sync
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, businessDate, status])
}

/** Amenities are shared vocabulary, attachable to a room type or a room. */
model Amenity {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  code       String
  name       String
  category   String @default("ROOM") // ROOM | BATHROOM | TECH | ACCESSIBILITY | PROPERTY
  icon       String?

  property  Property        @relation(fields: [propertyId], references: [id])
  roomTypes RoomTypeAmenity[]
  rooms     RoomAmenity[]

  @@unique([tenantId, propertyId, code])
}

model RoomTypeAmenity {
  id         String @id @default(uuid())
  tenantId   String
  roomTypeId String
  amenityId  String

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
}

model RoomAmenity {
  id        String @id @default(uuid())
  tenantId  String
  roomId    String
  amenityId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomId, amenityId])
}

/**
 * A dated removal of a room from sellable inventory (§7.2). Distinct from the
 * momentary operational status: a block has a range, a reason and an owner,
 * and availability must subtract it.
 */
model RoomBlock {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String
  type         String    @default("OUT_OF_ORDER") // OUT_OF_ORDER | OUT_OF_SERVICE | HOUSE_USE
  reason       String
  startDate    String // ISO date, inclusive
  endDate      String // ISO date, exclusive
  status       String    @default("ACTIVE") // ACTIVE | RELEASED
  createdById  String
  releasedById String?
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status, startDate])
}

// §13.3 — tax rules are versioned by effective date. Posted folio lines store
// the rule version they were billed under, so changing configuration never
// rewrites history.
model TaxRule {
  id                 String  @id @default(uuid())
  tenantId           String
  propertyId         String
  code               String // VAT | LSCT | SVC
  name               String
  rateBp             Int // basis points (750 = 7.5%)
  appliesTo          String  @default("ALL") // ALL | ROOM | FB
  basis              String  @default("EXCLUSIVE") // EXCLUSIVE | INCLUSIVE
  compoundOrder      Int     @default(1) // lower runs first; VAT usually after service
  taxOnServiceCharge Boolean @default(true)
  version            Int     @default(1)
  effectiveFrom      String // ISO date
  effectiveTo        String? // null = open-ended
  createdById        String?

  property Property @relation(fields: [propertyId], references: [id])

  @@unique([tenantId, propertyId, code, version])
  @@index([tenantId, propertyId, effectiveFrom])
}

model RatePlan {
  id           String  @id @default(uuid())
  tenantId     String
  propertyId   String
  roomTypeId   String
  code         String
  name         String
  refundable   Boolean @default(true)
  minStay      Int     @default(1)
  includesBreakfast Boolean @default(false)
  status       String  @default("ACTIVE")

  property     Property          @relation(fields: [propertyId], references: [id])
  roomType     RoomType          @relation(fields: [roomTypeId], references: [id])
  dailyRates   DailyRate[]
  restrictions RateRestriction[]

  @@unique([tenantId, propertyId, code])
}

// Per-date pricing overrides; falls back to the room type base rate.
model DailyRate {
  id         String @id @default(uuid())
  tenantId   String
  ratePlanId String
  date       String // ISO date
  rateMinor  BigInt
  closed     Boolean @default(false) // restriction: closed to arrival/stay

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([ratePlanId, date])
}

// §13.4 — threshold-driven approvals with an explicit second actor.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  type          String // DISCOUNT | REFUND | FOLIO_REOPEN | CASH_VARIANCE | RATE_OVERRIDE
  entityType    String
  entityId      String
  amountMinor   BigInt?
  reason        String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  payload       String    @default("{}") // JSON: what to apply on approval
  requestedById String
  decidedById   String?
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId, propertyId, status])
}

// §10.4 — operationId is the idempotency key for offline mutations.
model SyncOperation {
  id          String   @id @default(uuid())
  tenantId    String
  operationId String
  deviceId    String
  userId      String
  entityType  String
  entityId    String
  action      String
  status      String // APPLIED | CONFLICT | REJECTED
  detail      String   @default("{}")
  createdAt   DateTime @default(now())

  @@unique([tenantId, operationId])
  @@index([tenantId, deviceId, createdAt])
}

model Outlet {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  code       String
  name       String
  type       String @default("RESTAURANT") // RESTAURANT | BAR | ROOM_SERVICE | SPA | LAUNDRY
  status     String @default("ACTIVE")

  property  Property   @relation(fields: [propertyId], references: [id])
  menuItems MenuItem[]
  orders    PosOrder[]

  @@unique([tenantId, propertyId, code])
}

model MenuItem {
  id         String  @id @default(uuid())
  tenantId   String
  outletId   String
  code       String
  name       String
  category   String  @default("MAINS")
  priceMinor BigInt
  taxable    Boolean @default(true)
  active     Boolean @default(true)

  outlet Outlet         @relation(fields: [outletId], references: [id])
  lines  PosOrderLine[]

  @@unique([tenantId, outletId, code])
}

model PosOrder {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  outletId      String
  orderNumber   String
  status        String    @default("OPEN") // OPEN | SETTLED | VOIDED
  settlement    String? // ROOM_POSTING | CASH | CARD | POS_TERMINAL | TRANSFER
  folioId       String? // set when posted to a guest room folio
  tableRef      String?
  subtotalMinor BigInt    @default(0)
  serviceMinor  BigInt    @default(0)
  taxMinor      BigInt    @default(0)
  totalMinor    BigInt    @default(0)
  businessDate  String
  shiftId       String?
  voidReason    String?
  openedById    String?
  settledAt     DateTime?
  createdAt     DateTime  @default(now())

  outlet Outlet         @relation(fields: [outletId], references: [id])
  shift  CashierShift?  @relation(fields: [shiftId], references: [id])
  lines  PosOrderLine[]

  @@unique([tenantId, propertyId, orderNumber])
  @@index([tenantId, propertyId, businessDate, status])
}

model PosOrderLine {
  id          String @id @default(uuid())
  tenantId    String
  orderId     String
  menuItemId  String
  description String
  quantity    Int    @default(1)
  unitMinor   BigInt
  lineMinor   BigInt

  order    PosOrder @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// §7.4 / MVP: cashier shift open → movements → close with variance.
model CashierShift {
  id                String    @id @default(uuid())
  tenantId          String
  propertyId        String
  shiftNumber       String
  userId            String
  status            String    @default("OPEN") // OPEN | CLOSED | PENDING_APPROVAL
  openingFloatMinor BigInt    @default(0)
  countedMinor      BigInt?
  expectedMinor     BigInt?
  varianceMinor     BigInt?
  varianceReason    String?
  approvedById      String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?

  property  Property       @relation(fields: [propertyId], references: [id])
  movements CashMovement[]
  posOrders PosOrder[]

  @@unique([tenantId, propertyId, shiftNumber])
  @@index([tenantId, propertyId, status])
}

model CashMovement {
  id          String   @id @default(uuid())
  tenantId    String
  shiftId     String
  type        String // PAYMENT_IN | REFUND_OUT | DROP_TO_SAFE | PETTY_CASH_OUT | FLOAT_IN
  amountMinor BigInt // signed relative to the drawer
  reference   String?
  note        String?
  recordedById String?
  createdAt   DateTime @default(now())

  shift CashierShift @relation(fields: [shiftId], references: [id])

  @@index([tenantId, shiftId])
}

model MaintenanceTicket {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  roomId       String?
  title        String
  description  String?
  priority     String    @default("NORMAL") // URGENT | HIGH | NORMAL | LOW
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  blocksRoom   Boolean   @default(false)
  assignedTo   String?
  reportedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])

  @@index([tenantId, propertyId, status])
}

// §12.3: append-only. No update/delete path exists in the application.
/**
 * §13.3 — issued tax documents.
 *
 * An invoice is an immutable snapshot: the folio can carry on receiving
 * entries afterwards, but what was invoiced never changes. Corrections are
 * made by voiding and re-issuing, never by editing, because a tax document
 * that can be silently altered is worthless as evidence.
 */
model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  propertyId    String
  folioId       String
  invoiceNumber String // gapless per property/series, e.g. GPH-LAG/2026/000042
  type          String    @default("INVOICE") // INVOICE | RECEIPT | CREDIT_NOTE
  status        String    @default("ISSUED") // ISSUED | VOID
  // Frozen copy of the lines, taxes and guest details at issue time.
  snapshot      String
  subtotalMinor BigInt
  taxMinor      BigInt
  totalMinor    BigInt
  paidMinor     BigInt    @default(0)
  currency      String    @default("NGN")
  businessDate  String
  issuedById    String?
  issuedAt      DateTime  @default(now())
  voidedAt      DateTime?
  voidReason    String?
  // A credit note points at the invoice it reverses.
  reversesId    String?   @unique

  folio    Folio    @relation(fields: [folioId], references: [id])
  reverses Invoice? @relation("InvoiceReversal", fields: [reversesId], references: [id])
  reversedBy Invoice? @relation("InvoiceReversal")

  @@unique([tenantId, propertyId, invoiceNumber])
  @@index([tenantId, propertyId, businessDate])
}

/**
 * Gapless invoice numbering. Tax authorities require an unbroken sequence, so
 * the counter is a row that is locked and incremented inside the issuing
 * transaction rather than derived from COUNT(*), which would both race and
 * skip numbers when a transaction rolls back.
 */
model InvoiceSequence {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  series     String // usually the year
  lastNumber Int    @default(0)

  @@unique([propertyId, series])
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  propertyId String?
  actorType  String   @default("USER") // USER | API_CLIENT | SYSTEM | SUPPORT
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String // redacted JSON text
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, propertyId, createdAt(sort: Desc)])
}

// §9.3: written in the same transaction as the state change.
model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String // JSON text
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, occurredAt])
}

model NightAuditRun {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String
  businessDate String
  // §7.4 state machine: PREFLIGHT -> POSTING -> SNAPSHOT -> ADVANCING -> COMPLETED,
  // or FAILED with the phase that stopped it recorded in `steps`.
  status       String    @default("COMPLETED") // COMPLETED | FAILED
  phase        String    @default("COMPLETED")
  steps        String    @default("[]") // JSON: per-phase outcome and timing
  blockers     String    @default("[]") // JSON: unresolved pre-flight blockers
  summary      String // JSON text of KPI snapshot
  runById      String?
  completedAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  // §7.4: idempotent by property + business date
  @@unique([propertyId, businessDate])
}

/**
 * §11 — file metadata. PostgreSQL stays the source of truth for ownership,
 * access policy, checksum, status and retention; the object store only holds
 * bytes. A row exists before the upload does, so an abandoned upload is
 * visible rather than being an orphaned object nobody can account for.
 */
model FileObject {
  id           String    @id @default(uuid())
  tenantId     String
  propertyId   String?
  bucket       String // PUBLIC | PRIVATE
  objectKey    String
  originalName String
  contentType  String
  declaredSize Int
  actualSize   Int?
  checksumSha256 String?
  // PENDING -> UPLOADED -> SCANNING -> CLEAN | QUARANTINED, or EXPIRED.
  status       String    @default("PENDING")
  quarantineReason String?
  // What this file is attached to, so retention can reason about it.
  entityType   String?
  entityId     String?
  purpose      String    @default("GENERAL") // GUEST_ID | ROOM_IMAGE | INVOICE | EXPORT | GENERAL
  uploadedById String?
  expiresAt    DateTime? // intent expiry while PENDING; retention date once CLEAN
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([bucket, objectKey])
  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@index([status, expiresAt])
}
